---
// Boucle de crayon gras rouge, tracée à la main : la marque du monteur sur la planche contact.
// Le tracé est calculé dans un repère qui a les proportions de l'image entourée,
// pour que le trait garde la même épaisseur partout. Trois variantes pour que deux
// images voisines ne portent jamais le même trait.
interface Props {
  variant?: number;
  ratio?: number;
  class?: string;
}
const { variant = 0, ratio = 16 / 9, class: className } = Astro.props;

// Points dessinés dans un carré 100 × 100 : M x y, puis des courbes C (3 points chacune).
const shapes = [
  [9, 27, 14, 7, 62, 1, 88, 10, 101, 15, 100, 74, 90, 87, 76, 101, 22, 99, 8, 85, -3, 72, -1, 33, 15, 17, 27, 7, 52, 4, 70, 7],
  [14, 13, 38, 1, 84, 3, 94, 21, 102, 39, 99, 77, 84, 91, 64, 102, 19, 98, 7, 79, -2, 62, 1, 26, 21, 12, 33, 5, 49, 3, 61, 5],
  [91, 18, 76, 2, 24, 1, 9, 16, -1, 31, -1, 72, 11, 88, 25, 100, 76, 100, 91, 86, 101, 74, 102, 35, 86, 14, 77, 5, 58, 2, 41, 4],
];
const pts = shapes[Math.abs(variant) % shapes.length];
const w = 100 * ratio;
const xy = (i: number) => `${((pts[i] / 100) * w).toFixed(1)} ${pts[i + 1]}`;
let d = `M ${xy(0)}`;
for (let i = 2; i < pts.length; i += 6) d += ` C ${xy(i)}, ${xy(i + 2)}, ${xy(i + 4)}`;
const stroke = '1.7';
---
<svg class:list={['pencil-loop', className]} viewBox={`${(-0.06 * w).toFixed(1)} -6 ${(1.12 * w).toFixed(1)} 112`} aria-hidden="true" focusable="false">
  <path d={d} pathLength="1" stroke-width={stroke} />
</svg>

<style>
  .pencil-loop {
    position: absolute;
    top: -6%;
    left: -6%;
    width: 112%;
    height: 112%;
    overflow: visible;
    pointer-events: none;
    fill: none;
    z-index: 2;
  }

  .pencil-loop path {
    stroke: var(--red);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    opacity: 0;
    transition: stroke-dashoffset 620ms var(--ease-out), opacity 100ms linear;
  }

  :global([data-selected='true']) .pencil-loop path {
    stroke-dashoffset: 0;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .pencil-loop path {
      transition: opacity 100ms linear;
    }
  }
</style>
