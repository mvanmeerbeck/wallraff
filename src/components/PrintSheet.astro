---
// Tirages posés sur le papier : doubles pages de presse, couvertures de livres, sites.
// Même geste que la pellicule : la boucle de crayon rouge entoure le tirage survolé.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PencilLoop from './PencilLoop.astro';

export interface Print {
  href: string;
  image: ImageMetadata;
  alt?: string;
  title: string;
  meta: string;
}

interface Props {
  prints: Print[];
  label: string;
}
const { prints, label } = Astro.props;
---
<ul class="prints" aria-label={label}>
  {prints.map((p, i) => (
    <li class="print-item" data-print data-selected="false">
      <a href={p.href} class="print-link">
        <span class="print-frame">
          <Image src={p.image} alt={p.alt ?? ''} widths={[320, 480, 640, 900]} sizes="(max-width: 48rem) 92vw, (max-width: 80rem) 45vw, 28rem" class="print-img" />
          <PencilLoop variant={i + 1} ratio={p.image.width / p.image.height} />
        </span>
        <span class="print-caption">
          <span class="print-title">{p.title}</span>
          <span class="edge print-meta">{p.meta}</span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .prints {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    align-items: end;
    gap: var(--space-8) var(--space-7);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .print-link {
    display: grid;
    gap: var(--space-4);
    text-decoration: none;
  }

  .print-frame {
    position: relative;
    display: block;
  }

  .print-img {
    width: 100%;
    height: auto;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.18), 0 10px 24px -12px rgb(0 0 0 / 0.35);
  }

  .print-caption {
    display: grid;
    gap: 0.3rem;
  }

  .print-title {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .print-link:hover .print-title,
  .print-link:focus-visible .print-title {
    text-decoration: underline;
    text-decoration-color: var(--red-ink);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.2em;
  }

  .print-meta {
    color: var(--ink);
  }

</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-print]').forEach((item) => {
    const on = () => (item.dataset.selected = 'true');
    const off = () => (item.dataset.selected = 'false');
    item.addEventListener('pointerenter', on);
    item.addEventListener('pointerleave', off);
    item.addEventListener('focusin', on);
    item.addEventListener('focusout', off);
  });
</script>
