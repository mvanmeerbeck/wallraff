---
// Jeu d'icônes dessiné : trait de 2 px, extrémités arrondies, grille de 24.
interface Props {
  name: 'arrow' | 'arrow-left' | 'play' | 'phone' | 'mail' | 'menu' | 'close' | 'external' | 'download';
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'arrow-left' && <path d="M20 12H5M11 6l-6 6 6 6" />}
  {name === 'play' && <path d="M7 4.5v15l12.5-7.5z" fill="currentColor" stroke-width="1.5" />}
  {name === 'phone' && <path d="M5 3.5h3.2l1.6 4.4-2.2 1.5a11.5 11.5 0 0 0 6.9 6.9l1.5-2.2 4.4 1.6V19a1.5 1.5 0 0 1-1.6 1.5A16.6 16.6 0 0 1 3.5 5.1 1.5 1.5 0 0 1 5 3.5z" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="1" /><path d="m3.5 6 8.5 7 8.5-7" /></>}
  {name === 'menu' && <path d="M3 7h18M3 12h18M3 17h18" />}
  {name === 'close' && <path d="M5 5l14 14M19 5 5 19" />}
  {name === 'external' && <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />}
  {name === 'download' && <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />}
</svg>
