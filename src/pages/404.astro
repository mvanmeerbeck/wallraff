---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { nav } from '../data/site';
---
<Base title="Page introuvable" description="Cette page n’existe pas ou a été déplacée." closing={false}>
  <section class="wrap lost">
    <h1 class="lost-title">Aïe&nbsp;! Cette page est introuvable.</h1>
    <p class="lede">Elle a peut-être changé d’adresse avec la nouvelle version du site. Les films, les livres et les enquêtes sont toujours là.</p>
    <div class="lost-actions">
      <a class="action" href="/realisations/">Voir les réalisations <Icon name="arrow" /></a>
      <a class="action action--quiet" href="/contact/">Nous écrire</a>
    </div>
    <ul class="lost-nav">
      <li><a href="/">Accueil</a></li>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </section>
</Base>

<style>
  .lost {
    padding-block: var(--space-9);
    min-height: 60vh;
  }

  .lost-title {
    font-size: var(--step-5);
    max-width: 14ch;
  }

  .lost .lede {
    margin-top: var(--space-5);
  }

  .lost-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .lost-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-8) 0 0;
    padding: var(--space-5) 0 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }

  .lost-nav a {
    display: inline-block;
    padding-block: 0.5rem;
    font-family: var(--font-display);
    font-weight: 650;
  }
</style>
