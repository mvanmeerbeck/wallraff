---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import LiteYouTube from '../../../components/LiteYouTube.astro';
import FilmStrip from '../../../components/FilmStrip.astro';
import Icon from '../../../components/Icon.astro';
import { categories, type CategoryKey } from '../../../data/site';
import { getWorks, workHref, workMeta, creditLabel, isFilm, type Work } from '../../../data/works';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work) => ({
    params: { category: work.data.category, slug: work.id },
    props: { work, siblings: works.filter((w) => w.data.category === work.data.category) },
  }));
}

interface Props {
  work: Work;
  siblings: Work[];
}

const { work, siblings } = Astro.props;
const { Content } = await render(work);
const d = work.data;
const cat = categories[d.category as CategoryKey];
const film = isFilm(work);
const credits = Object.entries(d.credits ?? {}).filter(([, v]) => String(v).trim() !== '');
const idx = siblings.findIndex((w) => w.id === work.id);
const prev = siblings[idx - 1];
const next = siblings[idx + 1];
// Les logos de coproduction ne sont pas des images du film.
const stills = (d.images ?? []).filter((img) => img.width >= 500 && !/logo|production/i.test(img.src));
const altFor = (src: { src: string }) => {
  const file = src.src.split('/').pop()?.split('?')[0] ?? '';
  const key = Object.keys(d.imageAlts ?? {}).find((k) => file.startsWith(k.replace(/\.[a-z0-9]+$/i, '')));
  return key ? d.imageAlts[key] : '';
};
---
<Base title={d.title} description={d.excerpt} ogImage={d.cover}>
  <article class="work">
    <header class="wrap work-head">
      <h1 class="work-title">{d.title}</h1>
      <dl class="credits">
        <div><dt class="edge">Format</dt><dd>{cat.label}</dd></div>
        {credits.map(([k, v]) => (
          <div><dt class="edge">{creditLabel(k)}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </header>

    {film ? (
      <section class="projection on-film" aria-label="Le film">
        <div class="wrap projection-inner">
          {d.youtube ? (
            <LiteYouTube id={d.youtube} title={d.title} poster={d.cover} />
          ) : d.cover ? (
            <Image src={d.cover} alt={altFor(d.cover)} widths={[640, 960, 1280, 1600, 2000]} sizes="(max-width: 90rem) 100vw, 84rem" loading="eager" fetchpriority="high" class="projection-image" />
          ) : null}
          {d.video && !d.youtube && (
            <p class="projection-link"><a class="more" href={d.video} rel="noopener" target="_blank">Voir la vidéo <Icon name="external" /><span class="visually-hidden"> (nouvel onglet)</span></a></p>
          )}
        </div>
      </section>
    ) : d.cover ? (
      <figure class="wrap print">
        <div class="print-sheet">
          <Image src={d.cover} alt={altFor(d.cover)} widths={[480, 720, 960, 1280, 1600]} sizes="(max-width: 64rem) 92vw, 56rem" loading="eager" fetchpriority="high" class="print-image" />
          <span class="crop crop--tl" aria-hidden="true"></span>
          <span class="crop crop--tr" aria-hidden="true"></span>
          <span class="crop crop--bl" aria-hidden="true"></span>
          <span class="crop crop--br" aria-hidden="true"></span>
        </div>
      </figure>
    ) : null}

    <div class="wrap work-body">
      <div class="prose">
        <Content />
      </div>
      {d.links.length > 0 && (
        <aside class="work-links" aria-label="Liens">
          <h2 class="edge">À lire, à voir</h2>
          <ul>
            {d.links.map((l) => (
              <li><a href={l.url} rel="noopener" target="_blank">{l.label}<Icon name="external" /><span class="visually-hidden"> (nouvel onglet)</span></a></li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    {stills.length > 0 && (
      <section class="stills" aria-labelledby="stills-title">
        <h2 id="stills-title" class="wrap stills-title">Images</h2>
        <FilmStrip
          label={`Images de ${d.title}`}
          note={false}
          size="md"
          selected={-1}
          frames={stills.map((img, i) => ({ href: img.src, image: img, alt: altFor(img), title: `${d.title} ${String(i + 1).padStart(2, '0')}`, meta: 'Image' }))}
        />
      </section>
    )}

    <nav class="wrap pager" aria-label={`Autres ${cat.plural.toLowerCase()}`}>
        {prev ? (
          <a class="pager-link" href={workHref(prev)}>
            <span class="edge pager-dir"><Icon name="arrow-left" /> Précédent</span>
            <span class="pager-title">{prev.data.title}</span>
            <span class="edge pager-meta">{workMeta(prev)}</span>
          </a>
        ) : <span />}
        <a class="pager-all" href={cat.href}>{film ? `Tous les ${cat.plural.toLowerCase()}` : 'Presse – Édition – Internet'}</a>
        {next ? (
          <a class="pager-link pager-link--next" href={workHref(next)}>
            <span class="edge pager-dir">Suivant <Icon name="arrow" /></span>
            <span class="pager-title">{next.data.title}</span>
            <span class="edge pager-meta">{workMeta(next)}</span>
          </a>
        ) : <span />}
      </nav>
  </article>
</Base>

<style>
  .work-head {
    padding-block: var(--space-8) var(--space-7);
  }


  .work-title {
    font-size: var(--step-5);
    max-width: 16ch;
  }

  /* Générique : la même grille d'étiquettes sur chaque réalisation. */
  .credits {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-5) var(--space-6);
    margin: var(--space-7) 0 0;
    padding-top: var(--space-5);
    border-top: 2px solid var(--ink);
    max-width: 64rem;
  }

  .credits dt {
    color: var(--ink);
  }

  .credits dd {
    margin: 0.3rem 0 0;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .projection {
    background: var(--ink);
    padding-block: clamp(1.5rem, 4vw, 3.5rem);
  }

  .projection-inner {
    max-width: 90rem;
  }

  .projection-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .projection-link {
    margin-top: var(--space-4);
  }

  .print {
    margin-block: 0;
  }

  .print-sheet {
    position: relative;
    width: fit-content;
    max-width: min(100%, 56rem);
    margin-inline: auto;
    padding: clamp(1rem, 3vw, 2.5rem);
  }

  .print-image {
    max-height: 80vh;
    width: auto;
    margin-inline: auto;
  }

  /* Repères de cadrage au crayon gras, posés comme de l'encre sur le tirage. */
  .crop {
    position: absolute;
    width: clamp(1.5rem, 3vw, 2.5rem);
    height: clamp(1.5rem, 3vw, 2.5rem);
    border: 0 solid var(--red);
    mix-blend-mode: multiply;
  }

  .crop--tl { top: 0; left: 0; border-top-width: 4px; border-left-width: 4px; }
  .crop--tr { top: 0; right: 0; border-top-width: 4px; border-right-width: 4px; }
  .crop--bl { bottom: 0; left: 0; border-bottom-width: 4px; border-left-width: 4px; }
  .crop--br { bottom: 0; right: 0; border-bottom-width: 4px; border-right-width: 4px; }

  .work-body {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) minmax(0, 20rem);
    justify-content: space-between;
    gap: var(--space-7);
    padding-block: var(--space-8);
  }

  .work-body .prose {
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .work-links h2 {
    color: var(--ink);
  }

  .work-links ul {
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }

  .work-links li {
    border-bottom: 1px solid var(--ink);
  }

  .work-links a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
    font-family: var(--font-display);
    font-weight: 650;
    text-decoration: none;
  }

  .work-links a:hover {
    text-decoration: underline;
    text-decoration-color: var(--red-ink);
  }

  .work-links :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: none;
    margin-top: 0.2rem;
    color: var(--red-ink);
  }

  .stills {
    padding-bottom: var(--space-8);
  }

  .stills-title {
    font-size: var(--step-3);
    margin-bottom: var(--space-5);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-6);
    padding-block: var(--space-6) var(--space-9);
    border-top: 2px solid var(--ink);
  }

  .pager-link {
    display: grid;
    gap: 0.4rem;
    padding-block: var(--space-4);
    text-decoration: none;
  }

  .pager-link--next {
    text-align: right;
    justify-items: end;
  }

  .pager-dir {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .pager-all {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 2px solid var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
  }

  .pager-all:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .pager-dir :global(svg) {
    width: 1.1em;
    height: 1.1em;
  }

  .pager-title {
    font-family: var(--font-display);
    font-weight: 850;
    font-stretch: 112%;
    font-size: var(--step-2);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .pager-link:hover .pager-title {
    text-decoration: underline;
    text-decoration-color: var(--red-ink);
    text-decoration-thickness: 0.08em;
  }

  @media (max-width: 56rem) {
    .work-body {
      grid-template-columns: 1fr;
    }

    .pager {
      grid-template-columns: 1fr;
    }

    .pager-link--next {
      text-align: left;
      justify-items: start;
    }
  }
</style>
